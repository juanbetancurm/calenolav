{
  "name": "calenolav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "api:build": "npm run build --workspace=@calenolav/api",
    "api:dev": "npm run dev --workspace=@calenolav/api",
    "api:test": "npm run test --workspace=@calenolav/api",
    "db:generate": "npm run generate --workspace=@calenolav/database",
    "db:migrate": "npm run migrate --workspace=@calenolav/database",
    "db:test": "npm run test --workspace=@calenolav/database",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "rolldown": "1.2.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild": false
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
