# Local development only. Copy this file to .env before starting Docker.
POSTGRES_DB=calenolav
POSTGRES_USER=calenolav
POSTGRES_PASSWORD=calenolav_local_only
POSTGRES_PORT=5432

# The backend will use this in the next milestone.
DATABASE_URL=postgresql://calenolav:calenolav_local_only@localhost:5432/calenolav

# Backend HTTP server
API_HOST=0.0.0.0
API_PORT=3000
COOKIE_SECURE=true

# Google OAuth encryption (required when the OAuth routes are enabled).
# Keep real keys only in the ignored .env file or a production secret manager.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=
OAUTH_ENCRYPTION_CURRENT_KEY_VERSION=
OAUTH_ENCRYPTION_KEYS=
